# This file contains examples only. Export variables in your shell;
# SIE-Agent does not automatically load .env files.
HOST=127.0.0.1
PORT=3210
SIE_DATA_DIR=./data
SIE_PYTHON=python3

# Configure model and MinerU credentials in the application's API settings.
# Optional environment variables for a self-hosted model:
# QWEN_BASE_URL=http://127.0.0.1:8000/v1
# QWEN_MODEL=your-model-id
# QWEN_API_KEY=
# MINERU_URL=http://127.0.0.1:8001
# MINERU_MODEL_URL=http://127.0.0.1:30000
# MINERU_API_KEY=

# Optional explicit SDK or legacy qwen-local provider configuration:
# PI_SDK_PATH=/absolute/path/to/sdk/index.js
# PI_MODELS_PATH=/absolute/path/to/models.json
